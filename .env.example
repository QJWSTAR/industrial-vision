# CSAM Repair — 环境变量配置模板
# 复制此文件为 .env 并填写实际值，或通过系统环境变量设置

# ============================================================
# 许可证与安全
# ============================================================
# HMAC 密钥（许可证验证）。生产环境必须设置，开发环境可不设置（使用内置开发密钥）
CSAM_HMAC_SECRET=

# ============================================================
# ZMQ 通信地址（旧版 + bridge 共用）
# ============================================================
# 覆盖默认的 ZMQ 地址（默认: macOS/Linux=ipc:///tmp/csam_engine, Windows=tcp://127.0.0.1:5555）
# CSAM_ZMQ_ADDRESS=tcp://127.0.0.1:5555

# ============================================================
# 日志
# ============================================================
# DEBUG / INFO / WARNING / ERROR
# CSAM_LOG_LEVEL=INFO

# ============================================================
# Bridge 通信层（repair_app/bridge/）
# ============================================================
# 请求超时（毫秒）
# CSAM_BRIDGE_TIMEOUT_MS=30000
# 连接超时（毫秒）
# CSAM_BRIDGE_CONNECT_MS=5000
# 健康检查超时（毫秒）
# CSAM_BRIDGE_HEALTH_MS=2000
# 心跳间隔（毫秒）
# CSAM_BRIDGE_HEARTBEAT_MS=2000
# 心跳丢失阈值（连续丢失次数触发重连）
# CSAM_BRIDGE_HEARTBEAT_MISS=3
# 最大重试次数
# CSAM_BRIDGE_MAX_RETRIES=3
# 重试初始间隔（毫秒）
# CSAM_BRIDGE_RETRY_MS=200
# 延迟日志阈值（毫秒，超过则记录 WARNING）
# CSAM_BRIDGE_LATENCY_LOG_MS=5000

# ============================================================
# MATLAB 执行平台（repair_app/engine/）
# ============================================================
# MATLAB Server 监听地址（matlab_server/startup.m 读取）
# CSAM_MATLAB_BIND=tcp://*:5570
# MatlabEngine 连接主机
# CSAM_MATLAB_HOST=127.0.0.1
# MatlabEngine 连接端口
# CSAM_MATLAB_PORT=5570
# MATLAB Server 日志目录
# CSAM_MATLAB_LOG_DIR=./logs
# MATLAB Server 心跳间隔（毫秒）
# CSAM_MATLAB_HEARTBEAT_MS=1000
# 设为 1 强制禁用 MATLAB 引擎（降级到 Python 原型引擎，用于调试）
# CSAM_ENGINE_DISABLE_MATLAB=0

# ============================================================
# 引擎生命周期监控（repair_app/engine/lifecycle.py）
# ============================================================
# 客户端心跳间隔（毫秒）
# CSAM_HEARTBEAT_INTERVAL_MS=2000
# 心跳探测超时（毫秒）
# CSAM_HEARTBEAT_TIMEOUT_MS=3000
# 心跳丢失阈值（触发 RECONNECTING 状态）
# CSAM_HEARTBEAT_MISS_THRESHOLD=3
# 最大重连尝试次数
# CSAM_RECONNECT_MAX_ATTEMPTS=10
