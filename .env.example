# CSAM Repair — 环境变量配置模板
# 复制此文件为 .env 并填写实际值，或通过系统环境变量设置

# --- HMAC 密钥（许可证验证） ---
# 生产环境必须设置，开发环境可不设置（使用内置开发密钥）
CSAM_HMAC_SECRET=

# --- ZMQ 通信地址 ---
# 覆盖默认的 ZMQ 地址（默认: macOS/Linux=ipc:///tmp/csam_engine, Windows=tcp://127.0.0.1:5555）
# CSAM_ZMQ_ADDRESS=tcp://127.0.0.1:5555

# --- 日志级别 ---
# DEBUG / INFO / WARNING / ERROR
# CSAM_LOG_LEVEL=INFO

# --- MATLAB 引擎 ---
# MATLAB 服务端监听地址（供 repair_engine_service.py 使用）
# CSAM_ZMQ_ADDRESS=ipc:///tmp/csam_engine
